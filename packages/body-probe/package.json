{
  "name": "@asi/body-probe",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Periodic sampler for machine body vitals (CPU, memory, disks, battery, network, process, tokens) used by asi-sense.",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "dsh": "0.2.2-rc.3 || 0.2.2-rc.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@asi/sense-types": "workspace:*"
  }
}
