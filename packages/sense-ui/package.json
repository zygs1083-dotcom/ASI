{
  "name": "@asi/sense-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "asi-sense 侧栏面板：React 纯 props 组件 + Vite 预览",
  "engines": {
    "dsh": "0.2.2-rc.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --browser.enabled=false --exclude '**/*.test.tsx'",
    "test:browser": "vitest run --browser.headless --exclude '**/*.test.ts'",
    "e2e": "pnpm test:browser && playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@asi/sense-types": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitest/browser": "3.2.4",
    "axe-core": "^4.10.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "3.2.4"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./model": {
      "types": "./src/view-model.ts",
      "import": "./src/view-model.ts",
      "default": "./src/view-model.ts"
    }
  }
}
