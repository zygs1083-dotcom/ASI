{
  "name": "asi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
