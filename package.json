{
  "name": "asi",
  "productName": "ASI",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal macOS chat client built on pi-ai",
  "author": "ASI contributors",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "npm run build && playwright test",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "0.73.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.asi.chat",
    "productName": "ASI",
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "overrides": {
    "basic-ftp": "6.2.6"
  }
}
