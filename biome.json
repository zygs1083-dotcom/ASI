{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!out",
      "!dist",
      "!release",
      "!artifacts",
      "!test-results",
      "!playwright-report",
      "!logs",
      "!package-lock.json",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/types.ts", "src/renderer/styles/tokens.css"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
