{
  "name": "asi",
  "version": "0.7.0",
  "private": true,
  "description": "Unified biomimetic homeostasis and L5 cognition (L0 sense, L1 survival needs, L2 sleep memory vault, L3 workspace care, L4 skill synthesis, prefrontal intuition, Theory of Mind, DMN dream insights) for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zygs1083-dotcom/ASI.git",
    "directory": "plugins/asi"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "homeostasis",
    "memory",
    "skills",
    "agentskills",
    "macos"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "dsh": "0.2.2-rc.3 || 0.2.2-rc.5"
  },
  "exports": {
    ".": {
      "types": "./src/host/dsh/index.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./types": {
      "types": "./src/host/dsh/wire-types.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/asi-sense-helper",
    "cordis.patch.yml",
    "scripts/dsh.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@asi/body-probe": "workspace:*",
    "@asi/presence-protocol": "workspace:*",
    "@asi/sense-types": "workspace:*",
    "@asi/sense-ui": "workspace:*",
    "minisearch": "7.2.0",
    "ts-fsrs": "5.2.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@playwright/test": "1.61.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "^4.10.3",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "4.23.1",
    "vite": "^7.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && node scripts/build.mjs",
    "pack:dist": "pnpm run build && node scripts/pack-dist.mjs && node scripts/pack-verify.mjs",
    "release:check": "pnpm run pack:dist && node scripts/release-check.mjs",
    "e2e:registry": "node scripts/e2e-registry.mjs",
    "check": "pnpm run typecheck && pnpm exec biome check . && pnpm test",
    "generate": "node scripts/generate-typert.mjs",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
