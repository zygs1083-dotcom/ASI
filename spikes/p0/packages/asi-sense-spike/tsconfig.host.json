{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/index.ts", "src/types.ts"]
}
